{
  "name": "caminhos-do-caparao",
  "version": "1.0.0",
  "description": "Caminhos do Caparaó — marketplace de turismo rural (painel administrativo PWA + API + PostgreSQL)",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:backup": "node db/backup.js",
    "push:keys": "web-push generate-vapid-keys",
    "test": "node --test test/*.test.mjs",
    "test:ui": "node test/ui/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "license": "MIT"
}
