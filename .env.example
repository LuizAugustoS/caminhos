# Conexão com o PostgreSQL
DATABASE_URL=postgres://caminhos:caminhos@localhost:5432/caminhos

# Porta do servidor HTTP
PORT=3000

# Segredo usado para assinar o cookie de sessão (troque em produção!)
SESSION_SECRET=troque-este-segredo-em-producao

# Credenciais do admin criado pelo seed
ADMIN_EMAIL=admin@caminhosdocaparao.com.br
ADMIN_PASSWORD=caparao2026

# ─── Gerador de roteiros por IA ("Montar roteiro pra mim") ───────────────────
# Provedor: 'local' (regras sobre o catálogo, sem dependências — padrão),
#           'anthropic' (Claude API) ou 'n8n' (webhook do seu fluxo N8N).
# Se o provedor externo falhar, o gerador local assume automaticamente.
AI_PROVIDER=local

# Para AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# Para AI_PROVIDER=n8n — o webhook recebe { preferences, catalog } via POST
# e deve responder { title, notes, items: [{ listing_id|null, label|null, note|null }] }
# N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com/webhook/roteiro-caparao
