# Conexão com o PostgreSQL
DATABASE_URL=postgres://caminhos:caminhos@localhost:5432/caminhos

# Porta do servidor HTTP
PORT=3000

# Ambiente. Use 'production' no ar: ativa o cookie de sessão Secure e o HSTS.
NODE_ENV=production

# Segredo usado para assinar o cookie de sessão (troque em produção — use um
# valor longo e aleatório, ex.: `openssl rand -hex 32`).
SESSION_SECRET=troque-este-segredo-em-producao

# Credenciais do admin criado pelo seed (troque a senha em produção)
ADMIN_EMAIL=admin@caminhosdocaparao.com.br
ADMIN_PASSWORD=caparao2026
# Senha das contas demo criadas pelo seed (turista/produtor de exemplo)
DEMO_PASSWORD=caparao2026

# ─── Operação ────────────────────────────────────────────────────────────────
# Pasta das imagens em disco (aponte para um volume persistente; em disco
# efêmero as fotos somem no redeploy — ou use S3/R2 abaixo).
# UPLOADS_DIR=/data/uploads
# Pasta dos backups gerados por `npm run db:backup`.
# BACKUP_DIR=/data/backups
# Log de requisições no console. Desligue com LOG_REQUESTS=0 (erros 5xx sempre logam).
# LOG_REQUESTS=1

# ─── Gerador de roteiros por IA ("Montar roteiro pra mim") ───────────────────
# Provedor: 'local' (regras sobre o catálogo, sem dependências — padrão),
#           'anthropic' (Claude API) ou 'n8n' (webhook do seu fluxo N8N).
# Se o provedor externo falhar, o gerador local assume automaticamente.
AI_PROVIDER=local

# Para AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# Para AI_PROVIDER=n8n — o webhook recebe { preferences, catalog } via POST
# e deve responder { title, notes, items: [{ listing_id|null, label|null, note|null }] }
# N8N_WEBHOOK_URL=https://seu-n8n.exemplo.com/webhook/roteiro-caparao

# ─── E-mails transacionais (recuperação de senha, reservas, aprovações) ──────
# Sem SMTP_HOST os e-mails são apenas registrados no log do servidor.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=senha
# SMTP_SECURE=false          # true para porta 465
# MAIL_FROM="Caminhos do Caparaó <no-reply@caminhosdocaparao.com.br>"
# APP_URL=https://app.exemplo.com   # URL pública usada nos links dos e-mails

# ─── Armazenamento de imagens (avatares, fotos de anúncio/estabelecimento) ───
# Padrão: disco local (UPLOADS_DIR). Em PaaS com disco efêmero as fotos somem
# no redeploy — use S3 ou Cloudflare R2 (requer: npm i @aws-sdk/client-s3):
# S3_BUCKET=meu-bucket
# S3_REGION=auto                 # 'auto' para R2
# S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com   # vazio para AWS S3
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_URL=https://cdn.exemplo.com    # URL pública/CDN do bucket
# S3_FORCE_PATH_STYLE=false

# ─── Rastreamento de erros (opcional) ────────────────────────────────────────
# Sem SENTRY_DSN o recurso fica desligado (requer: npm i @sentry/node):
# SENTRY_DSN=https://...

# ─── Rate-limit ──────────────────────────────────────────────────────────────
# Padrão: em memória (instância única). Para rodar várias instâncias atrás de
# um load balancer, use o Postgres como store compartilhado:
# RATE_LIMIT_STORE=db

# ─── Notificações push (Web Push/VAPID) ──────────────────────────────────────
# Gere as chaves com: npm run push:keys — sem elas o recurso fica desligado.
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:contato@caminhosdocaparao.com.br
